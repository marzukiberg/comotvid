{
  "name": "comotvid",
  "version": "1.2.0",
  "private": true,
  "description": "ComotVid — Media Downloader (Jinja2 + Alpine.js + SCSS)",
  "scripts": {
    "build:css": "npx -y sass style.scss style.css --no-source-map",
    "watch:css": "npx -y sass --watch style.scss style.css --no-source-map",
    "dev": "npm run build:css && PORT=${PORT:-8787} ./dev.sh",
    "start": "npm run build:css && python3 server.py",
    "lint:dup": "npx jscpd",
    "check": "npm run lint:dup && node --check app.js && node --check public-app.js && python3 -c \"import ast; ast.parse(open('server.py').read())\""
  },
  "devDependencies": {
    "jscpd": "^4.0.5",
    "sass": "^1.83.0"
  }
}
